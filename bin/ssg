#!/usr/bin/env bash
# shellcheck disable=SC2034  # globals are shared across the sourced modules
# ssg — systemd unit generator: services, timers, sockets and path units with
# version-aware sandboxing, validation and linting.
set -Eeuo pipefail
shopt -s inherit_errexit 2> /dev/null || true

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  echo "ssg needs Bash 4.4 or newer (found $BASH_VERSION)." >&2
  exit 1
fi

# Resolve symlinks so an install like /usr/local/bin/ssg → …/bin/ssg works.
_src=${BASH_SOURCE[0]}
while [[ -L $_src ]]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd)
  _src=$(readlink "$_src")
  [[ $_src == /* ]] || _src=$_dir/$_src
done
SSG_ROOT=$(cd -P "$(dirname "$_src")/.." && pwd)
unset _src _dir

for _m in core validate model harden presets render install lint explain wizard cli; do
  # shellcheck source=/dev/null
  source "$SSG_ROOT/lib/$_m.sh"
done
unset _m

usage() {
  cat << 'EOF'
ssg — the systemd unit generator

Usage: ssg [GLOBAL OPTIONS] COMMAND [ARGS]

Commands
  new         Generate a service (+ timer / socket / path) — wizard or flags   [default]
  lint        Check any unit file for mistakes, typos, deprecated and weak settings
  score       Security exposure score (systemd-analyze security, or offline coverage)
  explain     Explain a directive in plain English (ssg explain ProtectSystem)
  presets     List presets          profiles   Show what each --harden level sets
  uninstall   Stop, disable and remove a unit ssg installed
  doctor      Check this machine (systemd version, tools, permissions)
  completion  Print shell completion (bash)
  version     Print version

Global options: -q/--quiet  --no-color  --debug  -h/--help  -V/--version

Examples
  ssg                                           # guided wizard
  ssg new --exec '/usr/bin/node /srv/app.js' --preset node --user app --yes --now
  ssg new --preset cron-job --exec /usr/local/bin/backup.sh --on-calendar 'Mon *-*-* 02:30' --yes
  ssg new --name web --bind-low-ports --harden strict --stdout -- /usr/local/bin/web --port 80
  ssg lint /etc/systemd/system/myapp.service
EOF
}

cmd_presets() {
  local p
  for p in "${PRESET_NAMES[@]}"; do printf '  %-15s %s\n' "$p" "${PRESET_DESC[$p]}"; done
}

cmd_profiles() {
  local level=${1-} l e
  for l in basic standard strict; do
    if [[ -n $level && $level != "$l" ]]; then continue; fi
    printf '%s%s%s\n' "$C_B" "$l" "$C_0"
    local -n arr="HARDEN_${l^^}"
    for e in "${arr[@]}"; do
      printf '  %-55s (systemd >= %s, %s)\n' "${e%%|*}" "$(cut -d'|' -f2 <<< "$e")" "$([[ ${e##*|} == s ]] && echo system || echo 'system+user')"
    done
    unset -n arr
    if [[ $l == standard ]]; then printf '  (plus everything in basic)\n'; fi
    if [[ $l == strict ]]; then printf '  (plus basic + standard, with ProtectSystem/ProtectHome tightened)\n'; fi
  done
}

cmd_score() {
  local scope=system arg="" a
  while (($#)); do
    a=$1
    shift
    case $a in
      --scope)
        scope=${1:?}
        shift
        ;;
      --scope=*) scope=${a#*=} ;;
      -*) die "Unknown option: $a" 2 ;;
      *) arg=$a ;;
    esac
  done
  [[ -n $arg ]] || die "Usage: ssg score UNIT|FILE [--scope user]" 2
  if [[ -f $arg ]]; then
    LINT_ERRORS=0 LINT_WARNINGS=0
    lint_file "$arg" "$scope" > /dev/null || true
    printf 'Offline sandbox coverage for %s: %s directives from the hardening set\n' "$arg" "${LINT_COVERAGE:-n/a (not a service)}"
    printf 'For the full exposure score install it and run: systemd-analyze security UNIT\n'
  else
    U[scope]=$scope
    score_unit "${arg%.service}.service" "$scope"
  fi
}

cmd_doctor() {
  local ok=1 t
  printf 'ssg %s on %s\n' "$(ssg_version)" "$(uname -sr)"
  printf '  bash            %s\n' "$BASH_VERSION"
  if command -v systemctl > /dev/null 2>&1; then
    printf '  systemd         %s\n' "$(sd_version)"
  else
    printf '  systemd         NOT FOUND (generation works, installing does not)\n'
    ok=0
  fi
  for t in systemd-analyze journalctl sudo; do
    if command -v "$t" > /dev/null 2>&1; then printf '  %-15s yes\n' "$t"; else printf '  %-15s no\n' "$t"; fi
  done
  printf '  privileges      %s\n' "$([[ $EUID -eq 0 ]] && echo root || echo 'user (sudo used for system scope)')"
  printf '  system units    %s\n' "$(unit_dir system)"
  printf '  user units      %s\n' "$(unit_dir user)"
  return $((1 - ok))
}

cmd_completion() {
  case ${1:-bash} in
    bash) cat "$SSG_ROOT/completions/ssg.bash" ;;
    *) die "Only bash completion is provided." 2 ;;
  esac
}

main() {
  local cmd=""
  while (($#)); do
    case $1 in
      -q | --quiet) SSG_QUIET=1 ;;
      --no-color)
        NO_COLOR=1
        init_colors
        ;;
      --debug) SSG_DEBUG=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      -V | --version)
        printf 'ssg %s\n' "$(ssg_version)"
        exit 0
        ;;
      *) break ;;
    esac
    shift
  done
  if (($#)) && [[ $1 != -* ]]; then
    cmd=$1
    shift
  fi
  case $cmd in
    "" | new)
      if [[ -z $cmd && $# -eq 0 ]] && ! is_interactive; then
        usage
        exit 0
      fi
      cmd_new "$@"
      ;;
    lint) cmd_lint "$@" ;;
    score) cmd_score "$@" ;;
    explain) cmd_explain "$@" ;;
    presets) cmd_presets ;;
    profiles) cmd_profiles "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    doctor) cmd_doctor ;;
    completion) cmd_completion "$@" ;;
    version) printf 'ssg %s\n' "$(ssg_version)" ;;
    help) usage ;;
    *) die "Unknown command '$cmd'. Try: ssg --help" 2 ;;
  esac
}

main "$@"
